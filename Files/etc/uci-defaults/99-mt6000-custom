#!/bin/sh
# X86_64 软路由首次启动个性化设置
# 说明：软路由无无线网卡，本脚本不做任何无线配置

#---------- 系统 ----------
uci -q batch <<-EOF
	set system.@system[0].hostname='X86_89'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	set system.@system[0].ttylogin='0'
	set system.@system[0].log_size='128'
	set system.@system[0].urandom_seed='0'
	delete system.ntp
	set system.ntp=timeserver
	set system.ntp.enabled='1'
	set system.ntp.enable_server='0'
	add_list system.ntp.server='ntp.tencent.com'
	add_list system.ntp.server='ntp.aliyun.com'
	add_list system.ntp.server='ntp.ntsc.ac.cn'
	add_list system.ntp.server='ntp.tuna.tsinghua.edu.cn'
	commit system
EOF

#---------- 网口 ----------
# x86 没有专属的 board.d，走通用回退 99-default_network：
#     ucidef_set_interface_lan 'eth0'
#     [ -d /sys/class/net/eth1 ] && ucidef_set_interface_wan 'eth1'
# WAN 只在 eth1 那一刻已就绪时才会被创建。虚拟机/网卡驱动加载慢时
# 常常来不及，结果就是刷完没有 WAN 口。这里补一道兜底。
WAN_PORT="eth1"
EXTRA_LAN="eth2 eth3"

. /lib/functions.sh

#---------- 兜底：WAN 不存在就补建 ----------
if [ -z "$(uci -q get network.wan)" ]; then
	uci -q batch <<-EOF
		set network.wan=interface
		set network.wan.device='$WAN_PORT'
		set network.wan.proto='dhcp'
		set network.wan6=interface
		set network.wan6.device='$WAN_PORT'
		set network.wan6.proto='dhcpv6'
		commit network
	EOF
fi

LAN_BRIDGE=""

find_lan_bridge() {
	local sec="$1"
	local name
	config_get name "$sec" name
	[ "$name" = "br-lan" ] && LAN_BRIDGE="$sec"
}

config_load network
config_foreach find_lan_bridge device

if [ -n "$LAN_BRIDGE" ]; then
	for PORT in $EXTRA_LAN; do
		# 已经在桥里就跳过，避免重复
		if uci -q get "network.$LAN_BRIDGE.ports" | grep -qw "$PORT"; then
			continue
		fi
		uci -q add_list "network.$LAN_BRIDGE.ports=$PORT"
	done
	uci -q commit network
fi

exit 0
